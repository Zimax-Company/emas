# mysql://user:pass@host:port/db  (append ?ssl=true for hosted MySQL, e.g. PlanetScale/Aiven/TiDB)
DATABASE_URL=mysql://emas:emas@127.0.0.1:3307/emas
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d
# Used by `npm run db:seed` to create the first system admin
SEED_ADMIN_EMAIL=admin@emas.local
SEED_ADMIN_PASSWORD=password
